# Copy to .env and change what you need. Every value here has a working
# default in lib/env.sh, so an empty .env is a valid .env.

# Compose project name and the external network app compose files join.
DOCKYARD_PROJECT=dockyard
DOCKYARD_NETWORK=dockyard

# Image versions. One major per engine, pinned here rather than in compose.yml
# so the running version is recorded in one place and an upgrade is a one-line
# change with a visible diff. Bumping a major generally means recreating that
# service's volume -- Postgres in particular will refuse to start on a data
# directory written by a different major.
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7-alpine
SEAWEEDFS_VERSION=4.48
MAILPIT_VERSION=latest
CADDY_VERSION=2-alpine

# Ports. All of these bind 127.0.0.1 only. That prefix is a security control,
# not a style choice: Docker programs packet filtering directly, so a bare
# "HOST:CONTAINER" mapping publishes a credentialed database to the whole
# local network even when a host firewall is running.
POSTGRES_PORT=5432
REDIS_PORT=6379
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_ADMIN_PORT=23646
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Caddy's port for http://<name>.localhost. Changing it means every URL
# carries the port, e.g. http://my-app.localhost:8080.
CADDY_HTTP_PORT=80

# Superuser credentials. These are local-only and never handed to a project:
# every project gets its own scoped role, user and key. Postgres reads its
# password only when initialising an empty data directory, so changing it
# after first start needs the volume recreated. SeaweedFS reads its pair on
# every start: it is the S3 admin key and the admin UI login.
POSTGRES_PASSWORD=dockyard
SEAWEEDFS_ROOT_USER=dockyard
SEAWEEDFS_ROOT_PASSWORD=dockyard-root

# Redis holds 16 databases and each project claims two, so the stack fits 8
# projects. Raising this needs a second Redis container rather than a bigger
# number: the per-project database number is what keeps one project's FLUSHDB
# from clearing everyone's cache.
REDIS_DATABASES=16

# How many messages Mailpit keeps before discarding the oldest.
MAILPIT_MAX_MESSAGES=5000

# The domain dockyard hands each project as its MAIL_FROM_ADDRESS, as
# <slug>@<domain>. Mailpit has one shared inbox, so this address is what
# `dockyard mail <slug>` filters on.
DOCKYARD_MAIL_DOMAIN=dockyard.test
